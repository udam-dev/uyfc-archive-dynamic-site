{
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!static/|.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico)$).*)" ,
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!static/|css/|js/|.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico)$).*)" ,
      "destination": "/api/index"
    }
  ]
}
